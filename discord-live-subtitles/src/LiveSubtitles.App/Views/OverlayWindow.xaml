<Window x:Class="LiveSubtitles.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Subtitles Overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="CanResizeWithGrip"
        Width="1000" Height="260">
    <Grid>
        <!-- Frame shown only while the overlay is movable (click-through off). -->
        <Border x:Name="EditFrame" BorderBrush="#995865F2" BorderThickness="2" CornerRadius="6" Background="#22000000"
                Visibility="{Binding IsMovable, Converter={StaticResource BoolToVis}}" />
        <Border x:Name="DragHandle" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0"
                Background="#CC5865F2" CornerRadius="4" Padding="10,2" Cursor="SizeAll"
                MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                Visibility="{Binding IsMovable, Converter={StaticResource BoolToVis}}">
            <TextBlock Foreground="White" FontSize="12" Text="⠿ Drag to move · resize from the corner · Ctrl+Alt+T to lock (click-through)" />
        </Border>
        <ItemsControl x:Name="Lines" ItemsSource="{Binding Lines}" VerticalAlignment="Bottom" Margin="8,30,8,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="6" Padding="12,5" Margin="0,3" HorizontalAlignment="Center" Opacity="{Binding Opacity}">
                        <Border.Background>
                            <SolidColorBrush Color="Black" Opacity="{Binding DataContext.BackgroundOpacity, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Border.Background>
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                                       FontFamily="{Binding DataContext.FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}}">
                                <TextBlock.Effect>
                                    <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.9" Color="Black" />
                                </TextBlock.Effect>
                                <Hyperlink Foreground="{Binding NameBrush}" TextDecorations="{x:Null}" FontWeight="Bold"
                                           Command="{Binding DataContext.SpeakerClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                           CommandParameter="{Binding}"
                                           ToolTip="Click to rename this speaker">
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                </Hyperlink><Run Text="{Binding NameSeparator, Mode=OneWay}" Foreground="{Binding NameBrush}" /><Run Text="{Binding Text, Mode=OneWay}" Foreground="{Binding TextBrush}" FontStyle="{Binding TextStyle, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Original}" TextWrapping="Wrap" TextAlignment="Center" Foreground="#D0D0D0" Margin="0,1,0,0"
                                       FontFamily="{Binding DataContext.FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="{Binding DataContext.OriginalFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Visibility="{Binding ShowOriginal, Converter={StaticResource BoolToVis}}">
                                <TextBlock.Effect>
                                    <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.9" Color="Black" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
