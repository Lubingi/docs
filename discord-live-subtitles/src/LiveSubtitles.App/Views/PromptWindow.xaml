<Window x:Class="LiveSubtitles.App.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True">
    <StackPanel Margin="16">
        <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBox x:Name="Input" Visibility="Collapsed" />
        <ComboBox x:Name="Choice" Visibility="Collapsed" DisplayMemberPath="Label" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
