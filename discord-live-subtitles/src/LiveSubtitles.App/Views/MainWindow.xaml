<Window x:Class="LiveSubtitles.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Subtitles for Discord" Width="980" Height="720" MinWidth="760" MinHeight="520"
        Icon="/Assets/app.ico" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Session bar -->
        <Border DockPanel.Dock="Top" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding StartStopLabel}" Command="{Binding StartStopCommand}" Style="{StaticResource PrimaryButton}" MinWidth="90" />
                    <Button Content="{Binding PauseLabel}" Command="{Binding TogglePauseCommand}" IsEnabled="{Binding IsRunning}" MinWidth="90" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0">
                    <TextBlock Text="{Binding ConnectionStatus}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SourceStatus}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding LatencyText, Mode=OneWay}" /> <Run Text="{Binding SentText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding LastError}" Foreground="Firebrick" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" Width="160" VerticalAlignment="Center">
                    <TextBlock Text="Input level" FontSize="11" Foreground="{StaticResource Muted}" />
                    <ProgressBar Height="8" Maximum="1" Value="{Binding InputLevel, Mode=OneWay}" />
                    <TextBlock Text="Speech detected" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                    <ProgressBar Height="8" Maximum="1" Value="{Binding SpeechProbability, Mode=OneWay}" Foreground="{StaticResource Accent}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="Tabs" Margin="8">
            <!-- ============================================================ SOURCE -->
            <TabItem Header="Session">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="OpenAI" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Set API key…" Command="{Binding SetApiKeyCommand}" />
                            <TextBlock Text="{Binding ApiKeyStatus}" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Audio source" />
                        <ComboBox ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding SelectedSource}" Width="360" HorizontalAlignment="Left" IsEnabled="{Binding CanEditSource}" />

                        <StackPanel Visibility="{Binding IsDiscordSource, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource Hint}" Text="Captures only Discord's own audio (Discord, PTB or Canary) with Windows per-app loopback. Your microphone, games and music are not included. If Discord restarts, capture re-attaches automatically." />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsAppSource, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource Hint}" Text="Test mode: capture any running app the same way as Discord, e.g. Chrome playing a Turkish or Norwegian YouTube video. ♪ marks apps playing audio right now." />
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" Width="420" IsEnabled="{Binding CanEditSource}" />
                                <Button Content="Refresh" Command="{Binding RefreshProcessesCommand}" Margin="6,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsFileSource, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource Hint}" Text="Test mode: plays a local .mp3 / .wav / .m4a file through the full pipeline in real time, exactly like a live call." />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseAudioFileCommand}" Margin="6,0,0,0" IsEnabled="{Binding CanEditSource}" />
                                <TextBox Text="{Binding AudioFilePath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditSource}" />
                            </DockPanel>
                            <CheckBox Content="Also play the file through my speakers" IsChecked="{Binding PlayFileToSpeakers}" IsEnabled="{Binding CanEditSource}" />
                            <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,6,0,0"
                                    Visibility="{Binding HasFileSession, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" Command="{Binding PlayPauseFileCommand}" MinWidth="40" Content="⏯" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding FileTimeText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <Slider Minimum="0" Maximum="{Binding FileDuration}" Value="{Binding FilePosition}" VerticalAlignment="Center" IsMoveToPointEnabled="True" />
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowDevicePicker, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource Hint}" Text="Output device to capture (fallback mode captures everything this device plays, including other apps — never your microphone)." />
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Width="420" IsEnabled="{Binding CanEditSource}" />
                                <Button Content="Refresh" Command="{Binding RefreshDevicesCommand}" Margin="6,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <CheckBox Content="If per-app capture fails, fall back to capturing the whole output device"
                                  IsChecked="{Binding FallbackToDevice}" IsEnabled="{Binding CanEditSource}"
                                  Visibility="{Binding IsDeviceSource, Converter={StaticResource InverseBoolToVis}}" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Subtitles" />
                        <CheckBox Content="Show the original-language text under each subtitle (adds gpt-realtime-whisper, $0.017/min)" IsChecked="{Binding ShowOriginal}" IsEnabled="{Binding CanEditSource}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Speech that is already in English:" VerticalAlignment="Center" Width="230" />
                            <ComboBox ItemsSource="{Binding SameLanguageOptions}" SelectedItem="{Binding SelectedSameLanguage}" Width="280" IsEnabled="{Binding CanEditSource}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="The model never re-translates English into English. With “show as-is”, English speakers appear using the original transcript (needs the option above). To avoid paying for someone who always speaks English, mute them on the Speakers tab." />
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="OpenAI noise reduction:" VerticalAlignment="Center" Width="230" />
                            <ComboBox ItemsSource="{Binding NoiseReductionOptions}" SelectedItem="{Binding SelectedNoiseReduction}" Width="280" IsEnabled="{Binding CanEditSource}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Overlay" />
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Show overlay" IsChecked="{Binding OverlayVisible}" Margin="0,0,16,0" />
                            <CheckBox Content="Click-through (locked)" IsChecked="{Binding Overlay.ClickThrough}" Margin="0,0,16,0" />
                            <Button Content="Reset position" Command="{Binding ResetOverlayPositionCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Games must run in borderless or windowed mode for any overlay to show on top. Turn click-through off to drag or resize the overlay." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ DEBUG -->
            <TabItem Header="Debug">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <CheckBox Content="Log raw events" IsChecked="{Binding Debug.LogRawEvents}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" />
                            <Button Content="Clear" Command="{Binding ClearDebugCommand}" Margin="0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                   Text="Every speech segment detected locally: who it was assigned to (cosine similarity to the best and next-best voice), latency, and the raw text streamed back." />
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Debug.Segments}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="40" />
                            <DataGridTextColumn Header="Start" Binding="{Binding Start}" Width="60" />
                            <DataGridTextColumn Header="Length" Binding="{Binding Duration}" Width="55" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                            <DataGridTextColumn Header="Speaker" Binding="{Binding Speaker}" Width="85" />
                            <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="115" />
                            <DataGridTextColumn Header="First text" Binding="{Binding FirstText}" Width="70" />
                            <DataGridTextColumn Header="Final" Binding="{Binding Final}" Width="65" />
                            <DataGridTextColumn Header="Lag" Binding="{Binding Lag}" Width="60" />
                            <DataGridTextColumn Header="Raw translation" Binding="{Binding Translation}" Width="2*" />
                            <DataGridTextColumn Header="Raw original" Binding="{Binding Original}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Style="{StaticResource SectionHeader}" Text="Event log" />
                    <ListBox Grid.Row="3" ItemsSource="{Binding Debug.RawLog}" FontFamily="Consolas" FontSize="12"
                             VirtualizingPanel.IsVirtualizing="True" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
