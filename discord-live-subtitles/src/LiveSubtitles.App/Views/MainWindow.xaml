<Window x:Class="LiveSubtitles.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:LiveSubtitles.Core.Settings;assembly=LiveSubtitles.Core"
        Title="Live Subtitles for Discord" Width="980" Height="720" MinWidth="760" MinHeight="520"
        Icon="/Assets/app.ico" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Session bar -->
        <Border DockPanel.Dock="Top" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding StartStopLabel}" Command="{Binding StartStopCommand}" Style="{StaticResource PrimaryButton}" MinWidth="90" />
                    <Button Content="{Binding PauseLabel}" Command="{Binding TogglePauseCommand}" IsEnabled="{Binding IsRunning}" MinWidth="90" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0">
                    <TextBlock Text="{Binding ConnectionStatus}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SourceStatus}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding CostText, Mode=OneWay}" /> <Run Text="{Binding LatencyText, Mode=OneWay}" /> <Run Text="{Binding SentText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding LastError}" Foreground="Firebrick" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" Width="160" VerticalAlignment="Center">
                    <TextBlock Text="Input level" FontSize="11" Foreground="{StaticResource Muted}" />
                    <ProgressBar Height="8" Maximum="1" Value="{Binding InputLevel, Mode=OneWay}" />
                    <TextBlock Text="Speech detected" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                    <ProgressBar Height="8" Maximum="1" Value="{Binding SpeechProbability, Mode=OneWay}" Foreground="{StaticResource Accent}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="Tabs" Margin="8">
            <!-- ============================================================ SOURCE -->
            <TabItem Header="Session">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="OpenAI" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Set API key…" Command="{Binding SetApiKeyCommand}" />
                            <TextBlock Text="{Binding ApiKeyStatus}" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Audio source" />
                        <ComboBox ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding SelectedSource}" Width="360" HorizontalAlignment="Left" IsEnabled="{Binding CanEditSource}" />

                        <StackPanel Visibility="{Binding IsDiscordSource, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource Hint}" Text="Captures only Discord's own audio (Discord, PTB or Canary) with Windows per-app loopback. Your microphone, games and music are not included. If Discord restarts, capture re-attaches automatically." />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsAppSource, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource Hint}" Text="Test mode: capture any running app the same way as Discord, e.g. Chrome playing a Turkish or Norwegian YouTube video. ♪ marks apps playing audio right now." />
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" Width="420" IsEnabled="{Binding CanEditSource}" />
                                <Button Content="Refresh" Command="{Binding RefreshProcessesCommand}" Margin="6,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsFileSource, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource Hint}" Text="Test mode: plays a local .mp3 / .wav / .m4a file through the full pipeline in real time, exactly like a live call." />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseAudioFileCommand}" Margin="6,0,0,0" IsEnabled="{Binding CanEditSource}" />
                                <TextBox Text="{Binding AudioFilePath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditSource}" />
                            </DockPanel>
                            <CheckBox Content="Also play the file through my speakers" IsChecked="{Binding PlayFileToSpeakers}" IsEnabled="{Binding CanEditSource}" />
                            <CheckBox Content="Call-quality simulation (band-limit, compression, noise, volume differences, rare dropouts) — can be toggled while playing" IsChecked="{Binding CallQuality}" />
                            <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,6,0,0"
                                    Visibility="{Binding HasFileSession, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" Command="{Binding PlayPauseFileCommand}" MinWidth="40" Content="⏯" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding FileTimeText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <Slider Minimum="0" Maximum="{Binding FileDuration}" Value="{Binding FilePosition}" VerticalAlignment="Center" IsMoveToPointEnabled="True" />
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowDevicePicker, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource Hint}" Text="Output device to capture (fallback mode captures everything this device plays, including other apps — never your microphone)." />
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Width="420" IsEnabled="{Binding CanEditSource}" />
                                <Button Content="Refresh" Command="{Binding RefreshDevicesCommand}" Margin="6,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <CheckBox Content="If per-app capture fails, fall back to capturing the whole output device"
                                  IsChecked="{Binding FallbackToDevice}" IsEnabled="{Binding CanEditSource}"
                                  Visibility="{Binding IsDeviceSource, Converter={StaticResource InverseBoolToVis}}" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Subtitles" />
                        <CheckBox Content="Show the original-language text under each subtitle (adds gpt-realtime-whisper, $0.017/min)" IsChecked="{Binding ShowOriginal}" IsEnabled="{Binding CanEditSource}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Speech that is already in English:" VerticalAlignment="Center" Width="230" />
                            <ComboBox ItemsSource="{Binding SameLanguageOptions}" SelectedItem="{Binding SelectedSameLanguage}" Width="280" IsEnabled="{Binding CanEditSource}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="The model never re-translates English into English. With “show as-is”, English speakers appear using the original transcript (needs the option above). To avoid paying for someone who always speaks English, mute them on the Speakers tab." />
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="OpenAI noise reduction:" VerticalAlignment="Center" Width="230" />
                            <ComboBox ItemsSource="{Binding NoiseReductionOptions}" SelectedItem="{Binding SelectedNoiseReduction}" Width="280" IsEnabled="{Binding CanEditSource}" />
                        </StackPanel>

                        <CheckBox Content="Label who is speaking (local voice recognition, no setup needed from anyone)" IsChecked="{Binding SpeakerIdEnabled}" IsEnabled="{Binding CanEditSource}" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Overlay" />
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Show overlay" IsChecked="{Binding OverlayVisible}" Margin="0,0,16,0" />
                            <CheckBox Content="Click-through (locked)" IsChecked="{Binding Overlay.ClickThrough}" Margin="0,0,16,0" />
                            <Button Content="Reset position" Command="{Binding ResetOverlayPositionCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Games must run in borderless or windowed mode for any overlay to show on top. Turn click-through off to drag or resize the overlay." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ SPEAKERS -->
            <TabItem Header="Speakers">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding SpeakerModelStatus}" />
                        <TextBlock Style="{StaticResource Hint}">
                            New voices get a number and colour automatically. Rename someone to have them recognised in future calls.
                            Tick <Bold>Mute</Bold> for people who speak English: once they're recognised (about a second into speaking), their speech is not sent to OpenAI, which saves money, and their lines are hidden.
                            Lines that don't clearly match anyone show “?” — click the name in the overlay or history to say who it was.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                            <Button Content="Rename…" Command="{Binding RenameSpeakerRowCommand}" CommandParameter="{Binding SelectedItem, ElementName=SpeakerGrid}" />
                            <Button Content="Merge into…" Command="{Binding MergeSpeakerRowCommand}" CommandParameter="{Binding SelectedItem, ElementName=SpeakerGrid}" />
                            <Button Content="Forget" Command="{Binding ForgetSpeakerRowCommand}" CommandParameter="{Binding SelectedItem, ElementName=SpeakerGrid}" />
                            <Button Content="Clear all voices…" Command="{Binding ClearAllSpeakersCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <DataGrid x:Name="SpeakerGrid" ItemsSource="{Binding Speakers}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                              MouseDoubleClick="SpeakerGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="28">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><Ellipse Width="14" Height="14" Fill="{Binding Brush}" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Name" Binding="{Binding Label}" Width="180" IsReadOnly="True" FontWeight="SemiBold" />
                            <DataGridTemplateColumn Header="Mute" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><CheckBox IsChecked="{Binding Muted, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Stored" Binding="{Binding SavedText}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="This session" Binding="{Binding Stats}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================================================ TEST TOOLS -->
            <TabItem Header="Test tools">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Test dialogue generator" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource Hint}" Text="Creates a short fake voice-chat conversation with 2–4 different OpenAI text-to-speech voices, saves it as a .wav (plus a .txt of who said what), and plays it through the full pipeline so you can check both translation and speaker labels. Costs well under $0.05 per dialogue." />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Text="Language" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding DialogueLanguages}" SelectedItem="{Binding DialogueLanguage}" Width="220" HorizontalAlignment="Left" Margin="0,2" />
                            <TextBlock Grid.Row="1" Text="{Binding DialogueSpeakers, StringFormat='Speakers ({0})'}" VerticalAlignment="Center" />
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="2" Maximum="4" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding DialogueSpeakers}" Width="220" HorizontalAlignment="Left" Margin="0,4" />
                            <TextBlock Grid.Row="2" Text="{Binding DialogueLines, StringFormat='Lines ({0})'}" VerticalAlignment="Center" />
                            <Slider Grid.Row="2" Grid.Column="1" Minimum="4" Maximum="20" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding DialogueLines}" Width="220" HorizontalAlignment="Left" Margin="0,4" />
                            <CheckBox Grid.Row="3" Grid.ColumnSpan="2" IsChecked="{Binding DialogueWriteScript}" Content="Write a new script with GPT (otherwise the built-in Turkish/Norwegian script is used)" />
                            <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Topic" Width="160" VerticalAlignment="Center" />
                                <TextBox Text="{Binding DialogueTopic}" Width="300" />
                                <TextBlock Text="Model" Margin="12,0,6,0" VerticalAlignment="Center" />
                                <TextBox Text="{Binding DialogueScriptModel}" Width="120" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="{Binding GenerateLabel}" Command="{Binding GenerateDialogueCommand}" Style="{StaticResource PrimaryButton}" />
                            <Button Content="▶ Play through the pipeline" Command="{Binding PlayDialogueCommand}" />
                            <Button Content="Open test audio folder" Command="{Binding OpenTestAudioFolderCommand}" />
                        </StackPanel>
                        <CheckBox Content="Play with call-quality simulation (sounds more like a real Discord call)" IsChecked="{Binding CallQuality}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding DialogueStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBox Text="{Binding DialogueScript, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,6,0,0" MinHeight="120" MaxHeight="260"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Segoe UI" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ HISTORY -->
            <TabItem Header="History">
                <DockPanel Margin="4">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Export .txt…" Command="{Binding ExportTxtCommand}" />
                            <Button Content="Export .srt…" Command="{Binding ExportSrtCommand}" />
                            <Button Content="Clear" Command="{Binding ClearHistoryCommand}" Margin="0" />
                        </StackPanel>
                        <CheckBox Content="Auto-scroll" IsChecked="{Binding History.AutoScroll}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Text="Kept in memory only. Right-click a line to rename or correct its speaker." />
                    </DockPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Save transcripts automatically to" IsChecked="{Binding AutoSaveTranscript}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AutoSaveFolder}" VerticalAlignment="Center" Margin="6,0" Foreground="{StaticResource Muted}" />
                            <Button Content="Change…" Command="{Binding ChooseAutoSaveFolderCommand}" />
                            <TextBlock Text="(off by default; text only, never audio)" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="HistoryGrid" ItemsSource="{Binding History.Rows}" SelectedItem="{Binding History.Selected}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              EnableRowVirtualization="True" SelectionMode="Single">
                        <DataGrid.ContextMenu>
                            <ContextMenu x:Name="HistoryMenu" Opened="HistoryMenu_Opened">
                                <MenuItem Header="Copy line" Command="{Binding CopySelectedLineCommand}" />
                                <MenuItem x:Name="RenameMenu" Header="Rename this speaker…" Click="HistoryRename_Click" />
                                <MenuItem x:Name="AssignMenu" Header="This line was said by" />
                                <MenuItem x:Name="MergeMenu" Header="This speaker is the same person as" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="70" />
                            <DataGridTemplateColumn Header="Speaker" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Speaker}" Foreground="{Binding SpeakerBrush}" FontWeight="SemiBold" Cursor="Hand"
                                                   ToolTip="Click to rename this speaker" MouseLeftButtonUp="HistorySpeaker_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Translation" Binding="{Binding Translation}" Width="3*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Original" Binding="{Binding Original}" Width="2*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Foreground" Value="#555" /></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================================================ GLOSSARY -->
            <TabItem Header="Glossary">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource Hint}">
                            gpt-realtime-translate does not accept prompts or glossaries, so these rules fix the text on your PC after translation.
                            <LineBreak /><Bold>Keep as-is</Bold>: a name or word that must appear exactly like this. Capitalised spellings one letter off, and any listed aliases, are corrected (Emir, Emrah → Emre).
                            <LineBreak /><Bold>Replace</Bold>: whole-word replacement, e.g. "brother" → "abi", "GG" → "good game". Longer phrases are matched first.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                            <Button Content="Add rule" Command="{Binding AddGlossaryEntryCommand}" />
                            <Button Content="Remove selected" Command="{Binding RemoveGlossaryEntryCommand}" CommandParameter="{Binding SelectedItem, ElementName=GlossaryGrid}" />
                        </StackPanel>
                    </StackPanel>
                    <DataGrid x:Name="GlossaryGrid" ItemsSource="{Binding Glossary}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              CellEditEnding="Glossary_CellEditEnding" RowEditEnding="Glossary_RowEditEnding">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="36" />
                            <DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding Mode}" Width="90"
                                                    ItemsSource="{Binding Source={x:Static core:GlossaryModesList.All}}" />
                            <DataGridTextColumn Header="Term" Binding="{Binding Term}" Width="*" />
                            <DataGridTextColumn Header="Replace with" Binding="{Binding Replacement}" Width="*" />
                            <DataGridTextColumn Header="Aliases / other spellings (comma separated)" Binding="{Binding Aliases}" Width="2*" />
                            <DataGridCheckBoxColumn Header="Also original" Binding="{Binding ApplyToOriginal, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                            <DataGridCheckBoxColumn Header="Match case" Binding="{Binding CaseSensitive, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================================================ SETTINGS -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SettingsPanel" Margin="12" MaxWidth="820" HorizontalAlignment="Left"
                                TextBoxBase.TextChanged="Settings_Changed" ToggleButton.Checked="Settings_Changed" ToggleButton.Unchecked="Settings_Changed"
                                Selector.SelectionChanged="Settings_Changed" RangeBase.ValueChanged="Settings_Changed"
                                UIElement.LostFocus="Settings_Changed">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Overlay appearance" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Font" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding Settings.Overlay.FontFamily}" Width="260" HorizontalAlignment="Left" Margin="0,2" />
                            <TextBlock Grid.Row="1" Text="{Binding Value, ElementName=SizeSlider, StringFormat='Text size ({0:0})'}" VerticalAlignment="Center" />
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="12" Maximum="64" x:Name="SizeSlider" Value="{Binding Settings.Overlay.FontSize}" Width="260" HorizontalAlignment="Left" Margin="0,4" />
                            <TextBlock Grid.Row="2" Text="{Binding Value, ElementName=OpacitySlider, StringFormat='Background opacity ({0:P0})'}" VerticalAlignment="Center" />
                            <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" x:Name="OpacitySlider" Value="{Binding Settings.Overlay.BackgroundOpacity}" Width="260" HorizontalAlignment="Left" Margin="0,4" />
                            <TextBlock Grid.Row="3" Text="{Binding Value, ElementName=LinesSlider, StringFormat='Max lines shown ({0})'}" VerticalAlignment="Center" />
                            <Slider Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="8" IsSnapToTickEnabled="True" TickFrequency="1" x:Name="LinesSlider" Value="{Binding Settings.Overlay.MaxLines}" Width="260" HorizontalAlignment="Left" Margin="0,4" />
                            <TextBlock Grid.Row="4" Text="{Binding Value, ElementName=FadeSlider, StringFormat='Fade out after ({0:0} s)'}" VerticalAlignment="Center" />
                            <Slider Grid.Row="4" Grid.Column="1" Minimum="2" Maximum="30" IsSnapToTickEnabled="True" TickFrequency="1" x:Name="FadeSlider" Value="{Binding Settings.Overlay.FadeSeconds}" Width="260" HorizontalAlignment="Left" Margin="0,4" />
                            <CheckBox Grid.Row="5" Grid.ColumnSpan="2" Content="Show the original-language line under each subtitle" IsChecked="{Binding Settings.Overlay.ShowOriginal}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="Position and width: turn click-through off and drag/resize the overlay itself. “Reset position” is on the Session tab." />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Global hotkeys" />
                        <TextBlock Style="{StaticResource Hint}" Text="Click a box and press the new key combination. Hotkeys work while Discord or a game has focus." />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Text="Start / stop" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding Settings.Hotkeys.StartStop, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" PreviewKeyDown="Hotkey_PreviewKeyDown" Margin="0,2" />
                            <TextBlock Grid.Row="1" Text="Pause / resume" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.Hotkeys.Pause, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" PreviewKeyDown="Hotkey_PreviewKeyDown" Margin="0,2" />
                            <TextBlock Grid.Row="2" Text="Show / hide overlay" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.Hotkeys.ToggleOverlay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" PreviewKeyDown="Hotkey_PreviewKeyDown" Margin="0,2" />
                            <TextBlock Grid.Row="3" Text="Toggle click-through" VerticalAlignment="Center" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.Hotkeys.ToggleClickThrough, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" PreviewKeyDown="Hotkey_PreviewKeyDown" Margin="0,2" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Button Content="Reset hotkeys" Command="{Binding ResetHotkeysCommand}" />
                            <TextBlock Text="{Binding HotkeyStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Translation" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Subtitle language" Width="200" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding OutputLanguages}" SelectedValuePath="Value" SelectedValue="{Binding Settings.OutputLanguage}" Width="200" IsEnabled="{Binding CanEditSource}" />
                        </StackPanel>
                        <CheckBox Content="Send audio continuously (also long silences): slightly better accuracy, much higher cost" IsChecked="{Binding Settings.SendContinuously}" IsEnabled="{Binding CanEditSource}" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Cost" />
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Spending cap per session ($)" Width="200" VerticalAlignment="Center" />
                            <TextBox Text="{Binding SpendingCapText, UpdateSourceTrigger=LostFocus}" Width="80" />
                            <TextBlock Text="  empty = no cap; the session pauses automatically when reached" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Price per minute: translate $" Width="200" VerticalAlignment="Center" />
                            <TextBox Text="{Binding Settings.TranslateUsdPerMinute}" Width="80" />
                            <TextBlock Text="  original text $" VerticalAlignment="Center" />
                            <TextBox Text="{Binding Settings.TranscribeUsdPerMinute}" Width="80" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="The running cost shown at the top is an estimate (audio minutes sent × these prices). Check platform.openai.com/usage for exact billing." />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="App" />
                        <CheckBox Content="Minimise and close to the system tray" IsChecked="{Binding Settings.MinimizeToTray}" />
                        <CheckBox Content="Start minimised in the tray" IsChecked="{Binding Settings.StartMinimized}" />

                        <Expander Header="Advanced tuning" Margin="0,12,0,0">
                            <StackPanel Margin="8">
                                <TextBlock Style="{StaticResource Hint}" Text="Changes apply the next time you press Start. The Debug tab shows how segments and text line up." />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="330" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <TextBlock Text="Speech threshold (0-1, higher = stricter)" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding Settings.Advanced.VadThreshold}" Margin="0,2" />
                                    <TextBlock Grid.Row="1" Text="Pause that ends a segment (ms)" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.Advanced.MinSilenceMs}" Margin="0,2" />
                                    <TextBlock Grid.Row="2" Text="Audio sent after speech stops (ms)" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.Advanced.TailMs}" Margin="0,2" />
                                    <TextBlock Grid.Row="3" Text="Longest segment before splitting (ms)" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.Advanced.MaxSegmentMs}" Margin="0,2" />
                                    <TextBlock Grid.Row="4" Text="Text this late belongs to the next segment (ms)" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.Advanced.CloseLagMs}" Margin="0,2" />
                                    <TextBlock Grid.Row="5" Text="Line is final after no new text for (ms)" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Settings.Advanced.FinalizeIdleMs}" Margin="0,2" />
                                    <TextBlock Grid.Row="6" Text="Voice match threshold (cosine)" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Settings.Diarization.MatchThreshold}" Margin="0,2" />
                                    <TextBlock Grid.Row="7" Text="New voice below similarity" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Settings.Diarization.NewSpeakerThreshold}" Margin="0,2" />
                                    <TextBlock Grid.Row="8" Text="Auto-merge voices above similarity" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Settings.Diarization.MergeThreshold}" Margin="0,2" />
                                    <TextBlock Grid.Row="9" Text="Model id" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Settings.Model}" Margin="0,2" />
                                </Grid>
                                <Button Content="Reset advanced settings" Command="{Binding ResetAdvancedCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ DEBUG -->
            <TabItem Header="Debug">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <CheckBox Content="Log raw events" IsChecked="{Binding Debug.LogRawEvents}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" />
                            <Button Content="Clear" Command="{Binding ClearDebugCommand}" Margin="0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                   Text="Every speech segment detected locally: who it was assigned to (cosine similarity to the best and next-best voice), latency, and the raw text streamed back." />
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Debug.Segments}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="40" />
                            <DataGridTextColumn Header="Start" Binding="{Binding Start}" Width="60" />
                            <DataGridTextColumn Header="Length" Binding="{Binding Duration}" Width="55" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                            <DataGridTextColumn Header="Speaker" Binding="{Binding Speaker}" Width="85" />
                            <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="115" />
                            <DataGridTextColumn Header="First text" Binding="{Binding FirstText}" Width="70" />
                            <DataGridTextColumn Header="Final" Binding="{Binding Final}" Width="65" />
                            <DataGridTextColumn Header="Lag" Binding="{Binding Lag}" Width="60" />
                            <DataGridTextColumn Header="Raw translation" Binding="{Binding Translation}" Width="2*" />
                            <DataGridTextColumn Header="Raw original" Binding="{Binding Original}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Style="{StaticResource SectionHeader}" Text="Event log" />
                    <ListBox Grid.Row="3" ItemsSource="{Binding Debug.RawLog}" FontFamily="Consolas" FontSize="12"
                             VirtualizingPanel.IsVirtualizing="True" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
